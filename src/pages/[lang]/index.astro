---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroBackground from '../../components/HeroBackground.astro';
import Lanyard from '../../components/LanyardDeferred';
import PortfolioSections from '../../components/PortfolioSections';
import {
  LOCALES,
  resolveLocale,
  type Locale,
} from '../../i18n/config';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({
    params: { lang },
  }));
}

const activeLocale = Astro.currentLocale || Astro.params.lang;
const locale: Locale = resolveLocale(activeLocale);
const currentPath = getRelativeLocaleUrl(locale, '');

const profileImageUrl = '/assets/profile.jpeg';
---

<BaseLayout
  locale={locale}
  title="Girish Lade: UI/UX Designer, Full-Stack Developer and LadeStack Founder"
  description="Explore the portfolio of Girish Balaso Lade, a UI/UX designer and full-stack developer creating privacy-conscious developer tools, web apps, and LadeStack products."
  currentPath={currentPath}
>
  <div id="homepage-wrapper" class="relative w-full">
    {/* Clean Hero Stage for 3D Lanyard */}
    <section
      id="lanyard-hero-slot"
      aria-label="Interactive 3D Lanyard Hero"
      class="relative z-30 w-full h-[380px] sm:h-[440px] lg:h-[480px] flex flex-col items-center justify-end select-none overflow-visible"
    >
      {/* Studio Exhibition Stage Background */}
      <HeroBackground imageUrl="/assets/aistudio/image_a475d35f.webp" />

      {/* 0ms SSR Lanyard Preview */}
      <div
        id="lanyard-ssr-preview"
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 z-20 flex flex-col items-center justify-start overflow-hidden transition-opacity duration-150"
      >
        {/* Woven Lanyard Strap */}
        <div
          id="lanyard-ssr-strap"
          class="w-[21px] sm:w-[24px] lg:w-[26px] h-[54px] sm:h-[64px] lg:h-[70px] shadow-xs"
        />
        {/* Metallic Silver Clamp */}
        <div class="w-[25px] sm:w-[29px] lg:w-[31px] h-[12px] sm:h-[14px] rounded-[3px] bg-gradient-to-b from-[#e4e7ec] via-[#cfd4dc] to-[#9ea4b0] border border-zinc-500/40 shadow-2xs -mt-[1px]" />
        {/* Metallic Ring */}
        <div class="w-[14px] sm:w-[16px] h-[14px] sm:h-[16px] rounded-full border-[2.5px] border-[#c8cdd6] shadow-2xs -mt-[3px] z-10" />
        {/* Portrait ID Card with Pre-Decoded Profile Image */}
        <div class="relative -mt-[7px] w-[140px] h-[197px] sm:w-[162px] sm:h-[228px] lg:w-[178px] lg:h-[250px] rounded-[14px] sm:rounded-[16px] bg-white dark:bg-[#141416] shadow-[0_10px_28px_rgba(0,0,0,0.12)] ring-1 ring-black/10 dark:ring-white/10 dark:shadow-[0_14px_36px_rgba(0,0,0,0.45)] overflow-hidden">
          <img
            id="lanyard-preload-profile"
            data-lanyard-src={profileImageUrl}
            src={profileImageUrl}
            alt="Girish Lade: UI/UX Designer and Full-Stack Developer"
            width="400"
            height="600"
            fetchpriority="high"
            loading="eager"
            decoding="async"
            class="w-full h-full object-cover select-none"
          />
          {/* Card Top Slot Punch Hole */}
          <div class="absolute top-[7px] sm:top-[8px] left-1/2 -translate-x-1/2 w-[30px] sm:w-[34px] h-[6px] sm:h-[7px] rounded-full bg-zinc-100 dark:bg-zinc-900 shadow-inner ring-1 ring-black/10 dark:ring-white/10" />
        </div>
      </div>

      {/* 3D Lanyard Canvas Stage */}
      <div
        id="lanyard-canvas-stage"
        class="pointer-events-none absolute top-0 left-0 right-0 h-[780px] sm:h-[880px] lg:h-[940px] z-30 overflow-visible"
      >
        <Lanyard
          client:idle
          frontImage={profileImageUrl}
          backImage={profileImageUrl}
          imageFit="cover"
          cardColor="#ffffff"
          orientation="portrait"
          finish="glossy"
          cornerRadius={0.28}
          size={0.52}
          anchor="center"
          strapLength={0.35}
          darkStrapColor="#c2410c"
          lightStrapColor="#ec7225"
          strapWidth={0.65}
          metal="silver"
          gravity={1}
          damping={0.5}
          elasticity={0.5}
          breeze={0.5}
          gyroscope={true}
          gyroSensitivity={1.1}
          heroSelector="#lanyard-hero-slot"
          interactive={true}
          intro={true}
        />
      </div>

      {/* Name plate: crisp, minimal, authoritative typography */}
      <div class="pointer-events-none absolute left-1/2 -translate-x-1/2 bottom-[46px] sm:bottom-[48px] lg:bottom-[52px] z-20">
        <h1
          id="hero-name"
          class="hero-name text-[26px] sm:text-[30px] lg:text-[34px] font-bold leading-none text-zinc-950 dark:text-zinc-50 whitespace-nowrap select-none tracking-tight"
        >
          Girish Lade
        </h1>
      </div>
    </section>

    {/* Portfolio Master Content */}
    <PortfolioSections client:visible={{ rootMargin: '200px' }} locale={locale} />
  </div>
</BaseLayout>

<style>
  .hero-name {
    font-family: var(--font-display);
    letter-spacing: -0.035em;
  }
</style>
