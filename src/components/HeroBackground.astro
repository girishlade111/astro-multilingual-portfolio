---
/**
 * Precision Studio Hero Stage Background (Stageshow Pattern)
 * Minimalist, architectural backdrop with subtle technical grid,
 * soft radial lighting, and precision corner alignment ticks.
 * Replaces generative AI botanical slop with a calm, enterprise-grade surface.
 */
interface Props {
  imageUrl?: string;
  darkImageUrl?: string;
}
---

<div
  id="lanyard-hero-background"
  data-testid="lanyard-hero-background"
  aria-hidden="true"
  class="pointer-events-none absolute inset-x-0 top-1.5 bottom-1.5 z-0 overflow-hidden rounded-2xl border border-zinc-200/90 bg-[#fafafa] dark:border-zinc-800/90 dark:bg-[#0c0c0e] shadow-2xs transition-colors duration-150 select-none"
>
  <!-- Architectural Technical Grid Layer -->
  <div class="absolute inset-0 opacity-[0.45] dark:opacity-[0.25]">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
      <defs>
        <pattern id="studio-grid" width="32" height="32" patternUnits="userSpaceOnUse">
          <path d="M 32 0 L 0 0 0 32" fill="none" stroke="currentColor" stroke-width="0.75" class="text-zinc-300 dark:text-zinc-800" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#studio-grid)" />
    </svg>
  </div>

  <!-- Soft Studio Radial Illumination Spotlight (Anchors the Hanging ID Card) -->
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_50%_42%,rgba(255,255,255,0.95)_0%,rgba(244,245,246,0.6)_60%,transparent_100%)] dark:bg-[radial-gradient(ellipse_60%_50%_at_50%_42%,rgba(24,24,27,0.85)_0%,rgba(14,14,17,0.5)_60%,transparent_100%)]"
  />

  <!-- Precision Corner Alignment Crosshairs -->
  <div class="absolute top-3 left-3 text-zinc-300 dark:text-zinc-700">
    <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1">
      <path d="M5 0v10M0 5h10" />
    </svg>
  </div>
  <div class="absolute top-3 right-3 text-zinc-300 dark:text-zinc-700">
    <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1">
      <path d="M5 0v10M0 5h10" />
    </svg>
  </div>
  <div class="absolute bottom-3 left-3 text-zinc-300 dark:text-zinc-700">
    <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1">
      <path d="M5 0v10M0 5h10" />
    </svg>
  </div>
  <div class="absolute bottom-3 right-3 text-zinc-300 dark:text-zinc-700">
    <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1">
      <path d="M5 0v10M0 5h10" />
    </svg>
  </div>

  <!-- Subtle Bottom Scrim for Crisp Name Plate Contrast -->
  <div
    class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-[#fafafa] via-[#fafafa]/70 to-transparent dark:from-[#0c0c0e] dark:via-[#0c0c0e]/75 dark:to-transparent"
  />

  <!-- Crisp Inner Frame Inset -->
  <div class="absolute inset-0 rounded-2xl ring-1 ring-inset ring-black/[0.03] dark:ring-white/[0.04]" />
</div>
