---
/**
 * Studio Hero Stage Background
 * Clean architectural exhibition surface with soft lighting and hairline framing.
 * Replaces synthetic grid and crosshairs with minimal enterprise surface.
 */
interface Props {
  imageUrl?: string;
  darkImageUrl?: string;
}
---

<div
  id="lanyard-hero-background"
  data-testid="lanyard-hero-background"
  aria-hidden="true"
  class="pointer-events-none absolute inset-x-0 top-1 bottom-1 z-0 overflow-hidden rounded-2xl border border-zinc-200/80 bg-zinc-50/60 dark:border-zinc-800/80 dark:bg-zinc-950/60 transition-colors duration-150 select-none"
>
  {/* Desktop responsive layer with soft radial illumination */}
  <div
    class="hidden sm:block absolute inset-0 bg-[radial-gradient(circle_at_50%_40%,rgba(255,255,255,0.92)_0%,rgba(244,244,245,0.4)_55%,transparent_85%)] dark:bg-[radial-gradient(circle_at_50%_40%,rgba(39,39,42,0.6)_0%,rgba(24,24,27,0.25)_55%,transparent_85%)]"
  />

  {/* Mobile responsive layer with focused ambient lighting */}
  <div
    class="block sm:hidden absolute inset-0 bg-[radial-gradient(circle_at_50%_45%,rgba(255,255,255,0.95)_0%,rgba(244,244,245,0.5)_60%,transparent_90%)] dark:bg-[radial-gradient(circle_at_50%_45%,rgba(39,39,42,0.7)_0%,rgba(24,24,27,0.3)_60%,transparent_90%)]"
  />

  {/* Subtle top light sheen */}
  <div
    class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-zinc-300 dark:via-zinc-700 to-transparent opacity-60"
  />

  {/* Soft bottom transition for nameplate contrast */}
  <div
    class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-zinc-50 via-zinc-50/70 to-transparent dark:from-zinc-950 dark:via-zinc-950/75 dark:to-transparent"
  />

  {/* Fine inner border ring */}
  <div class="absolute inset-0 rounded-2xl ring-1 ring-inset ring-black/[0.04] dark:ring-white/[0.05]" />
</div>
